local function sendFeedback(message)
	local httpReq = request or http_request or (syn and syn.request) or (http and http.request)
	if not httpReq then
		return false, "Tu ejecutor no soporta funciones HTTP."
	end

	local payload = {
		embeds = {{
			title = "⭐ Nueva sugerencia recibida",
			color = 65280,
			fields = {
				{ name = "Jugador", value = Player.Name .. " (@" .. Player.DisplayName .. ")", inline = true },
				{ name = "User ID", value = tostring(Player.UserId), inline = true },
				{ name = "Comentario", value = message:sub(1, 1000), inline = false }
			},
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local ok, response = pcall(function()
		return httpReq({
			Url = WEBHOOK_PROXY_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)

	if not ok or type(response) ~= "table" then
		return false, "Error de red al conectar con el servidor."
	end

	local code = response.StatusCode or response.Status
	if response.Success == false then
		return false, "El servidor rechazó el envío."
	end

	if code and (code < 200 or code >= 300) then
		return false, "Error de Webhook (Código HTTP " .. tostring(code) .. ")"
	end

	return true
end

local sending = false

local function updateCooldownDisplay()
	local left = remainingTime()
	if left > 0 then
		reviewStatus:Set("Próximo envío en " .. formatTime(left) .. ". El administrador dormilón revisará tu sugerencia. 💙")
	elseif not sending then
		reviewStatus:Set("Puedes enviar una nueva sugerencia.")
	end
end

reviewTab:CreateButton({
	name = "ENVIAR ✈",
	callback = function()
		if sending then return end

		if remainingTime() > 0 then
			updateCooldownDisplay()
			return
		end

		local msg = (reviewInput.value or ""):match("^%s*(.-)%s*$")
		if #msg < 3 then
			reviewStatus:Set("Escribe al menos 3 caracteres.")
			return
		end

		sending = true
		reviewStatus:Set("Enviando...")

		local success, err = sendFeedback(msg)
		sending = false

		if not success then
			reviewStatus:Set(err or "No se pudo enviar la sugerencia.")
			return
		end

		local saved = saveCooldown(os.time())
		reviewInput:Set("", true)

		window:Popup({
			title = "¡Gracias por tu sugerencia! 💙",
			content = "Cuando el administrador dormilón despierte y vea tu mensaje, lo tendrá en cuenta para la próxima actualización. 🚀",
		})

		if not saved then
			reviewStatus:Set("Aviso: no se pudo guardar el cooldown local.")
		else
			updateCooldownDisplay()
		end
	end,
})

task.spawn(function()
	while not window.unloaded do
		updateCooldownDisplay()
		task.wait(1)
	end
end)

