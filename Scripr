					if v:IsA("BasePart") then
						v.Material = Enum.Material.SmoothPlastic
					elseif v:IsA("Decal") or v:IsA("Texture") then
						v.Transparency = 1
					end
				end
			else
				Lighting.GlobalShadows = true
			end
		end)
	end,
})

--------------------------------------------------
-- 🌟 AUTOFARM COINS (NUEVO)
--------------------------------------------------
-- Todo va dentro de un bloque "do ... end" para no tocar ni
-- mezclarse con las variables de tu menú actual.

do
	local CollectionService = game:GetService("CollectionService")
	local StarterGui = game:GetService("StarterGui")

	-- ⚙️ AJUSTES (puedes cambiarlos)
	local AF_SPEED         = 30   -- studs/seg (el viaje a cada moneda nunca pasa de AF_MAX_TRAVEL)
	local AF_MAX_TRAVEL    = 2    -- máximo 2 segundos de viaje por moneda
	local AF_MIN_TRAVEL    = 0.25 -- mínimo de viaje (monedas muy pegadas)
	local AF_DWELL         = 0.5  -- segundos quieto sobre la moneda para que el servidor la registre
	local AF_DEPTH         = 3    -- cuánto bajo el centro de la moneda va tu cuerpo (cabeza medio en el suelo)
	local AF_COIN_SAFE     = 32   -- no va a monedas con el asesino a menos de esta distancia
	local AF_PATH_SAFE     = 16   -- el camino no debe pasar tan cerca del asesino
	local AF_PANIC_DIST    = 45   -- asesino cerca de ti: prioriza monedas que te alejen
	local AF_END_WAIT      = 4    -- seg sin monedas en el mapa = ronda terminada
	local AF_TELEPORT_DIST = 80   -- si el juego te mueve más que esto = te mandó al lobby

	local afActive = false
	local afBusy = false          -- true mientras está "bajo el suelo" con noclip
	local afRun = 0               -- id de ejecución (evita bucles viejos)
	local afConns = {}
	local afToggle
	local afLastPos = nil
	local afSavedCollide = {}
	local afVisited = setmetatable({}, { __mode = "k" })
	local afResetEvent = nil
	local afFallbackAt, afFallbackList = 0, {}

	local function afNotify(text)
		pcall(function()
			window:Notify({ title = "MM2 HUB ULTIMATE", content = text, duration = 5 })
		end)
	end

	-- Monedas del servidor (tag "ServerCoinPart", parte "Coin_Server")
	local function afGetCoins()
		local list = {}
		for _, c in ipairs(CollectionService:GetTagged("ServerCoinPart")) do
			if c:IsA("BasePart") and c:IsDescendantOf(workspace) then
				table.insert(list, c)
			end
		end
		if #list > 0 then return list end

		-- Respaldo por nombre (se refresca cada 1.5s para no gastar FPS)
		if os.clock() - afFallbackAt > 1.5 then
			afFallbackAt = os.clock()
			afFallbackList = {}
			for _, d in ipairs(workspace:GetDescendants()) do
				if d.Name == "Coin_Server" and d:IsA("BasePart") then
					table.insert(afFallbackList, d)
				end
			end
		end
		local out = {}
		for _, c in ipairs(afFallbackList) do
			if c.Parent and c:IsDescendantOf(workspace) then
				table.insert(out, c)
			end
		end
		return out
	end

	local function afMurdererPos()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= Player and p.Character then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hum and hum.Health > 0 and getPlayerRole(p) == "Murderer" then
					return hrp.Position
				end
			end
		end
		return nil
	end

	-- Distancia del punto p al segmento a→b
	local function afSegDist(a, b, p)
		local ab = b - a
		local len2 = ab:Dot(ab)
		if len2 < 1e-4 then return (p - a).Magnitude end
		local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
		return (p - (a + ab * t)).Magnitude
	end

	-- Elige la siguiente moneda: la más cercana, esquivando al asesino
	local function afPickCoin(coins, myPos, murPos)
		local best, bestScore
		for _, c in ipairs(coins) do
			if not afVisited[c] and c:FindFirstChild("TouchInterest") then
				local cp = c.Position
				local dMe = (cp - myPos).Magnitude
				local score = dMe
				local ok = true

				if murPos then
					local dMur = (cp - murPos).Magnitude
					local murNearMe = (myPos - murPos).Magnitude
					if dMur < AF_COIN_SAFE then
						ok = false
					elseif murNearMe >= AF_PATH_SAFE and afSegDist(myPos, cp, murPos) < AF_PATH_SAFE then
						ok = false
					elseif murNearMe < AF_PANIC_DIST then
						score = dMe - dMur * 0.7 -- prefiere monedas lejos del asesino
					end
				end

				if ok and (not bestScore or score < bestScore) then
					best, bestScore = c, score
				end
			end
		end
		return best
	end

	-- Mueve el cuerpo (devuelve false si el juego nos teletransportó)
	local function afSet(hrp, pos)
		if afLastPos and (hrp.Position - afLastPos).Magnitude > AF_TELEPORT_DIST then
			return false
		end
		hrp.CFrame = CFrame.new(pos)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		afLastPos = pos
		return true
	end

	-- Viaje lento hacia la moneda (máx. AF_MAX_TRAVEL segundos)
	local function afMoveTo(hrp, target, runId)
		local startPos = afLastPos or hrp.Position
		local dist = (target - startPos).Magnitude
		local dur = math.clamp(dist / AF_SPEED, AF_MIN_TRAVEL, AF_MAX_TRAVEL)
		local t0 = os.clock()

		while afActive and afRun == runId do
			local a = math.min((os.clock() - t0) / dur, 1)
			local pos = startPos:Lerp(target, a)
			if not afSet(hrp, pos) then return "tp" end
			if a >= 1 then return "ok" end

			-- Si el asesino se acerca a la moneda objetivo, cambia de ruta
			local m = afMurdererPos()
			if m and (m - target).Magnitude < AF_COIN_SAFE - 10 then
				return "abort"
			end
			RunService.Heartbeat:Wait()
		end
		return "stop"
	end

	local function afEngage(hum)
		afBusy = true
		hum.PlatformStand = true
	end

	-- Sale del modo "bajo el suelo": sube a la superficie y devuelve colisiones
	local function afRelease(skipSurface)
		if not afBusy then return end
		afBusy = false

		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local alive = hum and hum.Health > 0

		if not skipSurface and alive and hrp and afLastPos then
			pcall(function()
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				local ignore = { char }
				local origin = afLastPos + Vector3.new(0, AF_DEPTH + 3, 0)
				local hit
				for _ = 1, 6 do
					params.FilterDescendantsInstances = ignore
					hit = workspace:Raycast(origin, Vector3.new(0, -40, 0), params)
					if hit and not hit.Instance.CanCollide then
						table.insert(ignore, hit.Instance)
					else
						break
					end
				end
				local dest = hit and (hit.Position + Vector3.new(0, 3.5, 0)) or (afLastPos + Vector3.new(0, AF_DEPTH + 1, 0))
				hrp.CFrame = CFrame.new(dest)
			end)
		end

		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		for part in pairs(afSavedCollide) do
			if part.Parent then part.CanCollide = true end
		end
		afSavedCollide = {}
		if hum then
			hum.PlatformStand = false
			if alive then
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			end
		end
		afLastPos = nil
	end

	local AF_SKIP_SURFACE = { reset = true, void = true, tp = true, dead = true }
	local AF_AUTO_MSG = { auto = true, tp = true, dead = true }

	-- reason: user | reset | void  → "Autofarm coins deactivated"
	--         auto | tp | dead     → "Coin autofarm has been automatically disabled"
	local function afStop(reason, quiet)
		if not afActive then return end
		afActive = false
		afRun = afRun + 1

		for _, c in ipairs(afConns) do
			pcall(function() c:Disconnect() end)
		end
		afConns = {}

		pcall(function() StarterGui:SetCore("ResetButtonCallback", true) end)
		if afResetEvent then afResetEvent:Destroy() afResetEvent = nil end

		afRelease(AF_SKIP_SURFACE[reason] == true)

		if not quiet then
			if AF_AUTO_MSG[reason] then
				afNotify("Coin autofarm has been automatically disabled")
			else
				afNotify("Autofarm coins deactivated")
			end
			if reason ~= "user" and afToggle then
				afToggle:Set(false, true)
			end
		end
	end

	local function afStart()
		if afActive then return end

		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and hrp) or hum.Health <= 0 then
			if afToggle then afToggle:Set(false, true) end
			return
		end

		afActive = true
		afBusy = false
		afRun = afRun + 1
		local runId = afRun
		afLastPos = nil
		afSavedCollide = {}
		afVisited = setmetatable({}, { __mode = "k" })

		afNotify("autofarm coins activated")

		-- Noclip (solo mientras está recolectando)
		afConns[#afConns + 1] = RunService.Stepped:Connect(function()
			if not afBusy then return end
			local c = Player.Character
			if not c then return end
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") and d.CanCollide then
					afSavedCollide[d] = true
					d.CanCollide = false
				end
			end
		end)

		-- Muerte (asesino) o caída al vacío
		afConns[#afConns + 1] = hum.Died:Connect(function()
			local low = hrp.Position.Y < workspace.FallenPartsDestroyHeight + 25
			afStop(low and "void" or "dead")
		end)

		-- Reaparecer / volver al lobby
		afConns[#afConns + 1] = Player.CharacterAdded:Connect(function()
			afStop("dead")
		end)

		-- Botón de reiniciar personaje = regeneración intencional
		afResetEvent = Instance.new("BindableEvent")
		afConns[#afConns + 1] = afResetEvent.Event:Connect(function()
			local c = Player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			afStop("reset")
			if h then pcall(function() h.Health = 0 end) end
		end)
		pcall(function() StarterGui:SetCore("ResetButtonCallback", afResetEvent) end)

		task.spawn(function()
			local seenCoins, emptySince = false, nil

			local function stopMe(reason, quiet)
				if afRun == runId then afStop(reason, quiet) end
			end

			while afActive and afRun == runId do
				if window.unloaded then
					stopMe("user", true)
					break
				end

				local c = Player.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				local r = c and c:FindFirstChild("HumanoidRootPart")
				if not (h and r) or h.Health <= 0 then
					stopMe("dead")
					break
				end

				if r.Position.Y < workspace.FallenPartsDestroyHeight + 25 then
					stopMe("void")
					break
				end

				-- ¿Terminó la partida? (ya no quedan monedas en el mapa)
				local coins = afGetCoins()
				if #coins > 0 then
					seenCoins = true
					emptySince = nil
				elseif seenCoins then
					emptySince = emptySince or os.clock()
					if os.clock() - emptySince >= AF_END_WAIT then
						stopMe("auto")
						break
					end
				end

				local coin = nil
				if #coins > 0 then
					coin = afPickCoin(coins, afLastPos or r.Position, afMurdererPos())
				end

				if coin then
					if not afBusy then afEngage(h) end

					local target = coin.Position - Vector3.new(0, AF_DEPTH, 0)
					local result = afMoveTo(r, target, runId)

					if result == "tp" then
						stopMe("tp")
						break
					elseif result == "ok" then
						-- Se queda 0.5s sobre la moneda para que el servidor registre el toque
						if firetouchinterest then
							pcall(function() firetouchinterest(r, coin, 0) end)
						end
						local t0 = os.clock()
						local tpDetected = false
						while afActive and afRun == runId and os.clock() - t0 < AF_DWELL do
							if not afSet(r, target) then
								tpDetected = true
								break
							end
							RunService.Heartbeat:Wait()
						end
						if firetouchinterest then
							pcall(function() firetouchinterest(r, coin, 1) end)
						end
						if tpDetected then
							stopMe("tp")
							break
						end
						afVisited[coin] = true
					end
				elseif #coins > 0 and afBusy then
					-- Hay monedas pero ninguna segura / sin recoger: espera bajo el suelo
					if not afSet(r, afLastPos or r.Position) then
						stopMe("tp")
						break
					end
					RunService.Heartbeat:Wait()
				else
					-- Sin monedas todavía (lobby): espera normal sin congelarte
					afRelease()
					RunService.Heartbeat:Wait()
				end
			end
		end)
	end

	gameTab:CreateSection({ name = "Autofarm" })

	afToggle = gameTab:CreateToggle({
		name = "Autofarm Coins",
		callback = function(val)
			if val then
				afStart()
			else
				afStop("user")
			end
		end,
	})
end

